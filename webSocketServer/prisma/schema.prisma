



generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
    url  = env("DATABASE_URL")
 

   
   
}

model User {
  id String @id @default(uuid())
  email  String @unique
  refreshToken String?
  userOtp String
  otpExpires DateTime?
  interviews Interview[]
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Interview {
  id String @id  @default(uuid())
  roleId String?
  role Roles? @relation(fields: [roleId], references: [id])
  experienceId String?
  experience YearOfExperience? @relation(fields: [experienceId], references: [id])
  numberOfQuestionId String?
  numberOfQuestion NumberOfQuestion? @relation(fields: [numberOfQuestionId], references: [id])
  experienceValue String
  numberOfQuestionValue String
  roleValue String


  candidateName String
  
  questions Question[]
  overallScore Int?
  summary String?
  isCompleted Boolean @default(false)
  strengths String[]

  weaknesses String[]
  improvements String[]
  finalInterviewVerdict String?
  candidatePerspective String?
  
  
  selectionChances selectionChances?
  
    
   userId String?
  user User? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
}

model Question {
  id String @id @default(uuid())
  question String?
  interviewId String
  interview Interview @relation(fields: [interviewId], references: [id])

  
  expectedAnswer String[]
  score Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}


model YearOfExperience  {
  id String @id @default(uuid())
  experience String
  interview Interview[]
}

model Roles {
  id String @id @default(uuid())
  role String
  interview Interview[]
}

model NumberOfQuestion {
  id String @id @default(uuid())
  NumberOfQuestion String
  interview Interview[]
}


enum selectionChances {
  LOW
  MEDIUM
  HIGH
}


